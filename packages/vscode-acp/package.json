{
  "name": "crow-acp",
  "displayName": "Crow ACP Chat",
  "description": "Crow assistant-ui chat connected directly to a local ACP WebSocket agent.",
  "version": "0.1.0",
  "publisher": "crow-ai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:crowAcp.open",
    "onCommand:crowAcp.openSidebar",
    "onView:crowAcp.sidebar",
    "onView:crowAcp.sessions"
  ],
  "contributes": {
    "commands": [
      {
        "command": "crowAcp.open",
        "title": "Crow ACP: Open Chat"
      },
      {
        "command": "crowAcp.openSidebar",
        "title": "Crow ACP: Open Sidebar"
      },
      {
        "command": "crowAcp.session.open",
        "title": "Crow ACP: Open Session"
      },
      {
        "command": "crowAcp.session.new",
        "title": "New Session",
        "icon": "$(add)"
      },
      {
        "command": "crowAcp.sessions.refresh",
        "title": "Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "crowAcp.session.delete",
        "title": "Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "crowAcp.collapseAll",
        "title": "Toggle All Tool Calls and Thoughts",
        "icon": "$(collapse-all)"
      },
      {
        "command": "crowAcp.settings",
        "title": "Crow ACP Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "crowAcp.session.open",
          "when": "false"
        },
        {
          "command": "crowAcp.session.delete",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "crowAcp.session.new",
          "when": "view == crowAcp.sidebar || view == crowAcp.sessions",
          "group": "navigation@1"
        },
        {
          "command": "crowAcp.sessions.refresh",
          "when": "view == crowAcp.sessions",
          "group": "navigation@2"
        },
        {
          "command": "crowAcp.collapseAll",
          "when": "view == crowAcp.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "crowAcp.settings",
          "when": "view == crowAcp.sidebar",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "crowAcp.session.delete",
          "when": "view == crowAcp.sessions && viewItem == session",
          "group": "inline"
        },
        {
          "command": "crowAcp.session.delete",
          "when": "view == crowAcp.sessions && viewItem == session",
          "group": "1_modification@1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "crowAcp.sessions",
        "contents": "Sessions appear here once the Crow chat connects to an agent.\n[Open Crow Chat](command:crowAcp.openSidebar)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "crowAcp", "title": "Crow", "icon": "media/crow.svg" }
      ]
    },
    "views": {
      "crowAcp": [
        {
          "id": "crowAcp.sidebar",
          "name": "Crow ACP Chat",
          "type": "webview"
        },
        {
          "id": "crowAcp.sessions",
          "name": "Sessions"
        }
      ]
    },
    "configuration": {
      "title": "Crow ACP",
      "properties": {
        "crowAcp.accessibilityVerbosity": {
          "type": "boolean",
          "default": true,
          "tags": ["accessibility"],
          "description": "Announce how to open chat accessibility help when the chat gains focus."
        },
        "crowAcp.endpoint": {
          "type": "string",
          "default": "ws://127.0.0.1:2771/acp",
          "description": "Local ACP WebSocket endpoint, reached directly by the chat webview."
        },
        "crowAcp.cwd": {
          "type": "string",
          "default": "",
          "description": "Agent working directory. Empty uses the active workspace folder (a Linux path when the extension runs in WSL)."
        },
        "crowAcp.protocol": {
          "type": "string",
          "enum": [
            "auto",
            "1",
            "2"
          ],
          "default": "2",
          "description": "ACP protocol version. Auto uses the existing Crow client endpoint detection."
        },
        "crowAcp.mcpConfig": {
          "type": "string",
          "default": "mcpServers:\n  crow-mcp:\n    transport: stdio\n    command: crow-cli\n    args: [mcp2]\n",
          "description": "MCP server configuration (YAML or JSON) supplied to the agent. Stdio commands run on the agent machine."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --target=node --format=cjs --external=vscode --outfile=dist/extension.cjs && bun ../chat/node_modules/vite/bin/vite.js build --config vite.config.ts",
    "typecheck": "tsc --noEmit && bun run --cwd ../chat typecheck",
    "package": "bun run build && vsce package --no-dependencies --allow-missing-repository --out crow-acp-0.1.0.vsix"
  },
  "type": "module",
  "devDependencies": {
    "vite": "^8.3.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.9.3"
  }
}
