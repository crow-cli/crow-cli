# crow's product identity for the vendored VSCodium pipeline in ./vscodium.
# Sourced by ./build.sh. Every name here overrides a default in
# vscodium/utils.sh; every value flows into vscode/product.json (see
# vscodium/prepare_vscode.sh) and into the !!PLACEHOLDER!! substitution that
# vscodium/utils.sh:apply_patch performs on every patch before `git apply`.
#
# This file is the ONE place crow's brand is defined. Nothing else in
# packages/crow-gui should hardcode a product name.

# --- product identity -------------------------------------------------------
# APP_NAME is what humans see: window title, About, .desktop entry, deb/rpm
# package description. BINARY_NAME is the CLI on PATH (`crow`, `crow-server`,
# `crow-tunnel`). Flip APP_NAME to "Crowdium" if the IDE should carry the
# build's nickname instead of the brand; nothing else needs to change.
export APP_NAME="Crow"
export BINARY_NAME="crow"
export TUNNEL_APP_NAME="crow-tunnel"

# Derived by vscodium/utils.sh unless set here: APP_NAME_LC="crow" and
# GLOBAL_DIRNAME="crow", which give product.json its dataFolderName (~/.crow),
# serverDataFolderName (~/.crow-server), linuxIconName and urlProtocol.

# --- org / repo -------------------------------------------------------------
# Feeds !!ORG_NAME!!, !!GH_REPO_PATH!! and !!ASSETS_REPOSITORY!! patch
# substitution, the deb/rpm maintainer fields, and the Rust CLI's
# VSCODE_CLI_DOWNLOAD_ENDPOINT.
export ORG_NAME="crow-cli"
export GH_REPO_PATH="crow-cli/crow-cli"
export ASSETS_REPOSITORY="crow-cli/crow-cli"

# --- urls -------------------------------------------------------------------
export SITE_URL="https://crow-ai.dev"
export REPO_URL="https://github.com/${GH_REPO_PATH}"
export LICENSE_URL="${REPO_URL}/blob/main/LICENSE.md"
export REPORT_ISSUE_URL="${REPO_URL}/issues/new"

# macOS bundle identifier (reverse DNS of crow-ai.dev).
export DARWIN_BUNDLE_IDENTIFIER="dev.crow-ai.crow"

# --- updates ----------------------------------------------------------------
# crow publishes no update/release feed yet, so build exactly like VSCodium's
# Linux packages do: no updateUrl/downloadUrl in product.json, and
# patches/00-update-disable.patch.yet applied. Self-update and the CLI's
# "download a server build" paths are therefore inert; `crow serve-web` is
# expected to run the locally installed reh-web server instead.
export DISABLE_UPDATE=yes

# Inert while DISABLE_UPDATE=yes (product.json gets no updateUrl, and the Rust
# CLI at the pinned VS Code reads its update feed from product.json, not from
# VSCODE_CLI_UPDATE_ENDPOINT). Set so no crow artifact carries a VSCodium URL;
# point it at a real feed when crow publishes one.
export UPDATE_URL="${REPO_URL}/raw/main/versions"

# --- windows/macOS AppIds ---------------------------------------------------
# prepare_vscode.sh carries fresh crow GUIDs (VSCodium's AppIds would make a
# Windows crow installer collide with a VSCodium install). Nothing to set here
# until crow ships installers for those platforms.
