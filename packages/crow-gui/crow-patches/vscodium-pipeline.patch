++/*---------------------------------------------------------------------------------------------
++ *  Copyright (c) Microsoft Corporation. All rights reserved.
++ *  Licensed under the MIT License. See License.txt in the project root for license information.
++ *--------------------------------------------------------------------------------------------*/
++
++// crow: `crow agent` hands this terminal to the crow agent TUI — the
++// `crow-agent` binary built from the crow-cli repo's crates/crow-client. Not an
++// upstream command; added by packages/crow-gui
++// (vscodium/patches/user/01-cli-crow-agent.patch).
++
++use std::process::Command;
++
++use crate::{
++	commands::args::CrowAgentArgs,
++	util::errors::{wrap, AnyError},
++};
++
++/// `crow-cli install crow` builds the TUI and puts it on PATH.
++/// `CROW_AGENT_BIN` overrides the binary that gets exec'd.
++const DEFAULT_CROW_AGENT: &str = "crow-agent";
++
++pub fn crow_agent(args: CrowAgentArgs) -> Result<i32, AnyError> {
++	let bin = std::env::var("CROW_AGENT_BIN").unwrap_or_else(|_| DEFAULT_CROW_AGENT.to_owned());
++
++	let status = Command::new(&bin)
++		.args(args.passthrough)
++		.status()
++		.map_err(|e| {
++			wrap(
++				e,
++				format!("error running `{bin}` (is the crow agent TUI installed? `crow-cli install crow` builds it; CROW_AGENT_BIN overrides)"),
++			)
++		})?;
++
++	Ok(status.code().unwrap_or(1))
++}
