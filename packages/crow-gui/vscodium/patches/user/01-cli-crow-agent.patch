+++ b/cli/src/commands/crow_agent.rs
@@ -0,0 +1,36 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// crow: `crow agent` hands this terminal to the crow agent REPL. Not an upstream
+// command; added by packages/crow-gui (vscodium/patches/user/01-cli-crow-agent.patch).
+
+use std::process::Command;
+
+use crate::{
+	commands::args::CrowAgentArgs,
+	util::errors::{wrap, AnyError},
+};
+
+/// The crow agent ships in the `crow-cli` package, not in this repository.
+/// `CROW_CLI` overrides the binary that gets exec'd.
+const DEFAULT_CROW_CLI: &str = "crow-cli";
+
+pub fn crow_agent(args: CrowAgentArgs) -> Result<i32, AnyError> {
+	let bin = std::env::var("CROW_CLI").unwrap_or_else(|_| DEFAULT_CROW_CLI.to_owned());
+
+	let status = Command::new(&bin)
+		.arg("run")
+		.arg("-i")
+		.args(args.passthrough)
+		.status()
+		.map_err(|e| {
+			wrap(
+				e,
+				format!("error running `{bin} run -i` (is crow-cli installed and on PATH? set CROW_CLI to override)"),
+			)
+		})?;
+
+	Ok(status.code().unwrap_or(1))
+}
