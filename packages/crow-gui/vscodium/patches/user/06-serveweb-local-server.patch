+
+/// crow: the web server that ships with the IDE.
+///
+/// Upstream `serve-web` asks an update service which release is latest and
+/// downloads it into a cache on the first request. crow publishes no release
+/// tarballs to ask for: the `reh-web` server is built from source and installed
+/// beside the IDE — `/usr/share/crow/web` in the deb, `~/.local/share/crow/web`
+/// for `crow-cli install crow` — so that one server is the only version served,
+/// and finding it is a filesystem walk rather than a request.
+struct BundledServer {
+	/// The server's entrypoint script, `<root>/bin/crow-server`.
+	executable: PathBuf,
+	/// The release this server stands in for, read from the `product.json` beside
+	/// it so the version prefix the workbench asks for is the one it serves.
+	release: Release,
+}
+
+impl BundledServer {
+	/// Looks for the bundled server: `$CROW_WEB_DIR`, then the `web` directory
+	/// beside the IDE this CLI came from, then `<app>-web` in `/usr/bin`. Each
+	/// candidate may be a server root (holding `bin/<entrypoint>`) or the
+	/// entrypoint itself.
+	fn find(log: &log::Logger, platform: Platform, quality: Quality) -> Result<Self, CodeError> {
+		let entrypoint = quality.server_entrypoint()?;
+		let mut candidates = Vec::new();
+
+		if let Some(dir) = std::env::var_os(WEB_DIR_ENV) {
+			candidates.push(PathBuf::from(dir));
+		}
+		if let Some(dir) = std::env::current_exe()
+			.ok()
+			.and_then(|e| e.parent().map(|p| p.to_path_buf()))
+		{
+			// packaged IDE: <root>/bin/<cli>, server at <root>/web
+			candidates.push(dir.join("..").join(WEB_DIR_NAME));
+			// `crow-cli install crow`: <share>/ide/bin/<cli>, server at <share>/web
+			candidates.push(dir.join("..").join("..").join(WEB_DIR_NAME));
+		}
+		candidates.push(Path::new("/usr/bin").join(format!("{APPLICATION_NAME}-{WEB_DIR_NAME}")));
+
+		for candidate in &candidates {
+			let Some((root, executable)) = Self::resolve(candidate, &entrypoint) else {
+				continue;
+			};
+
+			let release = Self::read_release(&root, platform, quality);
+			info!(
+				log,
+				"found the bundled web server at {}",
+				executable.display()
+			);
+			return Ok(Self {
+				executable,
+				release,
+			});
+		}
+
+		let looked = candidates
+			.iter()
+			.map(|c| c.display().to_string())
+			.collect::<Vec<_>>()
+			.join(", ");
+		Err(CodeError::NoWebServerFound(
+			QUALITYLESS_PRODUCT_NAME.to_string(),
+			looked,
+		))
+	}
+
+	/// Turns a candidate into `(server root, entrypoint)`, if it is one.
+	fn resolve(candidate: &Path, entrypoint: &str) -> Option<(PathBuf, PathBuf)> {
+		if candidate.is_dir() {
+			let root = fs::canonicalize(candidate).unwrap_or_else(|_| candidate.to_path_buf());
+			let executable = root.join("bin").join(entrypoint);
+			executable.is_file().then_some((root, executable))
+		} else if candidate.is_file() {
+			// an entrypoint, or a symlink to one (e.g. /usr/bin/crow-web): the root
+			// is two levels up from the script it resolves to
+			let executable =
+				fs::canonicalize(candidate).unwrap_or_else(|_| candidate.to_path_buf());
+			let root = executable
+				.parent()
+				.and_then(Path::parent)
+				.map(|p| p.to_path_buf())
+				.unwrap_or_else(|| executable.clone());
+			Some((root, executable))
+		} else {
+			None
+		}
+	}
+
+	/// Reads the server's own `product.json` for the version and commit it serves
+	/// under. Both fall back: they only have to be stable, since the server
+	/// strips its own version prefix from the URLs it is asked for.
+	fn read_release(root: &Path, platform: Platform, quality: Quality) -> Release {
+		let product = fs::read_to_string(root.join("product.json"))
+			.ok()
+			.and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok());
+		let field = |key: &str| {
+			product
+				.as_ref()
+				.and_then(|p| p.get(key))
+				.and_then(|v| v.as_str())
+				.map(String::from)
+		};
+
+		Release {
+			name: field("version").unwrap_or_else(|| String::from("0.0.0")),
+			commit: field("commit")
+				.or_else(|| VSCODE_CLI_COMMIT.map(String::from))
+				.unwrap_or_else(|| String::from(UNKNOWN_COMMIT)),
+			platform,
+			target: TargetKind::Web,
+			quality,
+		}
+	}
 }
 
