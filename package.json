{
  "name": "crow-cli-web",
  "private": true,
  "description": "bun workspace for crow's chat webview and the vscode extension that ships it",
  "workspaces": [
    "packages/chat",
    "packages/editor",
    "packages/aui/*"
  ],
  "scripts": {
    "ext:build": "bun run --cwd packages/vscode-acp build",
    "ext:typecheck": "bun run --cwd packages/vscode-acp typecheck",
    "ext:package": "bun run --cwd packages/vscode-acp package",
    "chat:typecheck": "bun run --filter @crow/chat typecheck",
    "chat:test": "bun run --filter @crow/chat test"
  }
}
